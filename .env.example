# ---------------------------------------------------------------
# Vera runs with NONE of these set.
# Leave the file empty and it boots on SQLite in mock mode: the
# receptionist is a local state machine, speech uses the browser's
# built-in recognition and synthesis. Zero keys, zero cost.
#
# Add a value and that subsystem upgrades itself on next restart.
# ---------------------------------------------------------------

# --- Database -------------------------------------------------
# Unset  -> SQLite at DB_PATH. No install, no server, no account.
# Set    -> Postgres. Works with Neon, Supabase, Render, anything.
#
# On Vercel: add Neon from the Marketplace and this is injected for
# you. Use the POOLED connection string (host contains "-pooler"),
# or serverless cold starts will exhaust your connection limit.
DATABASE_URL=
DB_PATH=./data/vera.db

# --- AI -------------------------------------------------------
# Groq - free tier, no credit card. https://console.groq.com/keys
# Unlocks: real LLM replies (Llama 3.3 70B) + Whisper transcription.
GROQ_API_KEY=

# Google Gemini - free tier alternative. https://aistudio.google.com/apikey
# Used for the LLM only, if GROQ_API_KEY is absent.
GEMINI_API_KEY=

# --- Client ---------------------------------------------------
# Leave empty when the API is served from the same origin (the Vercel
# setup). Set it to a full URL to point the client at a separate
# backend, e.g. https://vera-api.onrender.com
VITE_API_URL=

# --- Server ---------------------------------------------------
PORT=4000
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production

# Starting credit balance for new accounts (1 credit = 1 minute)
SIGNUP_CREDITS=60
